{
  "TCP": {
    "443": {
      "HTTPS": true
    },
    "8601": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://app:8501"
        }
      }
    },
    "${TS_CERT_DOMAIN}:8601": {
      "Handlers": {
        "/": {
          "Proxy": "http://app:8502"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true
  }
}
